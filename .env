# =============================================================================
# tran-miss1ion-192 — Environment Configuration
# =============================================================================
# Edit values here, then redeploy (git pull + docker compose up -d --build).
# All variables have safe defaults; only change what you need.
# =============================================================================


# -----------------------------------------------------------------------------
# SeaweedFS
# -----------------------------------------------------------------------------

# URL of the SeaweedFS Filer inside the container.
# Change only if you run Filer on a different host or port.
SEAWEEDFS_FILER_URL=http://localhost:8888

# Remote path where uploaded files land in the Filer.
# Example: /music  →  files appear at http://<filer>/music/
SEAWEEDFS_DEST_PATH=/downloads


# -----------------------------------------------------------------------------
# Upload Mode
# Controls how completed torrents are packaged before upload to SeaweedFS.
# -----------------------------------------------------------------------------
#
# UPLOAD_MODE options:
#
#   files    — Upload every file individually, preserving the directory tree.
#              Best for streaming direct from Filer (no unpacking needed).
#              Default.
#
#   zip      — Pack the torrent folder into a single .zip before upload.
#              Opens natively on Windows, macOS, Linux.
#              Requires: zip APK (already in apk-cache).
#
#   tarzst   — Pack into a single .tar.zst (zstd-compressed tarball).
#              Fastest compression speed, best ratio for compressible content.
#              Windows needs 7-Zip or WinRAR; macOS needs Keka or homebrew zstd.
#              Requires: zstd APK (already in apk-cache).
#
UPLOAD_MODE=files

# Pack single-file torrents too?
#
#   false    — Single .mkv/.mp3/etc. uploads as-is (no wrapper). Default.
#   true     — Also wraps single files using UPLOAD_MODE (zip or tarzst).
#              Only takes effect when UPLOAD_MODE is zip or tarzst.
#
PACK_SINGLE_FILES=false
